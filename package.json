    "test": "tsc -p tsconfig.test.json && node --test $(find dist-tests -name '*.test.js' -print)"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "konva": "^9.3.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  }
}
